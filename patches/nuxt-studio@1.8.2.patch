+// Studio 1.8.2 keeps its active session private in this bundle (MP).
+if (typeof window !== "undefined") {
+  window.addEventListener("siegel:album-editor", (event) => {
+    if (!document.querySelector("nuxt-studio") || typeof window.useStudioHost !== "function") return;
+    const { isReady, documentTree, mediaTree, host } = MP();
+    if (isReady.value) event.detail.connect({
+      documents: documentTree.draft, media: mediaTree.draft,
+      getMediaTree: () => mediaTree.root.value,
+      hostDocument: host.document.db, hostMedia: host.media, dev: host.meta.dev,
+    });
+  });
